                "merchants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Vince's Eatery\"\n}"
            },
            "description": "Needs a MERCHANT_OWNER account. Starts as PENDING_APPROVAL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('merchantId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List merchants (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchants?status=PENDING_APPROVAL&page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchants"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING_APPROVAL"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "Returns { items, page, pageSize, total }. status is optional: PENDING_APPROVAL | APPROVED | SUSPENDED | REJECTED."
          }
        },
        {
          "name": "Approve merchant (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchants/{{merchantId}}/approve",
