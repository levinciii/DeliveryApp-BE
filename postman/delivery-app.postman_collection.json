{
  "info": {
    "name": "Delivery App API",
    "description": "Backend v0.1 (Express 5). Base URL includes /api. Register/Login/Refresh save the tokens into {{accessToken}} and {{refreshToken}}, so the next request is already authorised. Switching users = log in as them (the last login wins). ADMIN accounts come from `npx prisma db seed` with SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@test.com\",\n  \"password\": \"password123!\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "description": "role is optional (default CUSTOMER). Allowed: CUSTOMER, MERCHANT_OWNER, RIDER. Password needs 10+ characters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (merchant owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Merchant\",\n  \"email\": \"merchant@test.com\",\n  \"password\": \"password123!\",\n  \"role\": \"MERCHANT_OWNER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (rider)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Rider\",\n  \"email\": \"rider@test.com\",\n  \"password\": \"password123!\",\n  \"role\": \"RIDER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant@test.com\",\n  \"password\": \"password123!\"\n}"
            },
            "description": "Change the email to switch user (customer@test.com, merchant@test.com, or your seeded admin)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Refresh tokens rotate and work once. Sending an already-used one revokes all of that user's sessions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Returns 204."
          }
        }
      ]
    },
