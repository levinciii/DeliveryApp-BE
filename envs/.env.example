# App Settings
APP_NAME="Delivery App"
NODE_ENV=development
PORT=3000

# Generate a JWT secret (32+ characters) with this one-liner, then paste the output below:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="Use the command above to generate JWT_SECRET"

# Token lifetimes (optional - these are the defaults)
# ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=30

# Your own PostgreSQL login (see README section 1). URL-encode special characters in the password.
# Create an empty database first (e.g. DeliveryApp), then point DATABASE_URL at it.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DeliveryApp

# Comma-separated list of web origins allowed to call the API (customer-web, admin-web)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional: `npm run db:seed` creates (or promotes) this account as ADMIN so you can sign in to admin-web.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-please-123
